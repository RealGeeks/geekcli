<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>geekcli third-party licenses</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
  pre { white-space: pre-wrap; background: #f6f8fa; padding: 1rem; overflow-x: auto; }
  li { margin: .2rem 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>geekcli is MIT licensed. It includes the open-source crates below, under these licenses.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
